# wd-note-draft の認証情報。これをコピーして `.env` を作る（.env は gitignore 対象）。
#   cp .env.example .env
#
# note は公式 API が無いため、ログイン済みブラウザの Cookie を使う。

# 【必須】note にログインした状態の Cookie 文字列。
# 取り方（Chrome の例）:
#   1. https://note.com にログイン
#   2. F12 → Network タブ → note.com への任意のリクエストを選択
#   3. Request Headers の "cookie:" の値を丸ごとコピー
#   4. 下の "..." に貼る（_note_session_v5 と XSRF-TOKEN が含まれていること）
NOTE_COOKIE="..."

# 【任意】X-XSRF-TOKEN ヘッダに使う値。
# 未設定なら NOTE_COOKIE 内の XSRF-TOKEN を自動で復号して使うので、普通は不要。
# NOTE_XSRF_TOKEN="..."

# 【任意】画像アップロードの調整。既定はフロントエンド JS から確認した実エンドポイント。
# アップロードが失敗するとき、note 側の仕様変更に合わせて変える。
# NOTE_UPLOAD_ENDPOINT="/api/v1/image_upload/note_picture"
# NOTE_UPLOAD_FIELD="file"
